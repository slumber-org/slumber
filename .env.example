# SLUMBER (researcher) — copy to .env and fill in. Do not commit .env.

# Postgres (migrations and backend). Supabase: Settings → Database → Connection string → URI.
# DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

# Supabase API. Supabase: Settings → API.
# SUPABASE_URL=https://[project-ref].supabase.co
# SUPABASE_ANON_KEY=

# Service role key — required for admin commands: participant create, session create/update/delete, condition sync.
# Keep secret; never commit.
# SUPABASE_SERVICE_ROLE_KEY=

# Optional: CLI convenience defaults (replace --study-dir, --study-id, --user-id, --participant-id flags)
# STUDY_DIR=./my-study
# STUDY_ID=my-study
# USER_ID=
# PARTICIPANT_ID=

# Optional: override the default session file path (~/.config/slumber/session.json)
# SLUMBER_SESSION_FILE=

# Optional: Sentry error monitoring during study runs (install slumber[sentry] first)
# SENTRY_DSN=
