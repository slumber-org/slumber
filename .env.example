# Slumber (researcher) — copy to .env and fill in. Do not commit .env.

# Postgres (migrations and backend). Supabase: Connect → URI.
# DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

# Supabase API
# SUPABASE_URL=https://[project-ref].supabase.co
# SUPABASE_ANON_KEY=

# Service role (participant/session CLI; keep secret)
# SUPABASE_SERVICE_ROLE_KEY=

# Optional: monitoring
# SENTRY_DSN=
