# Slumber — copy to .env and fill in values. Do not commit .env.

# Postgres connection (required for migrations and backend). For Supabase, use
# the URI from project dashboard: Connect → URI (Session pooler or Direct).
# DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

# Supabase API (for Auth and client; used by condition sync and participant CLI).
# SUPABASE_URL=https://[project-ref].supabase.co
# SUPABASE_ANON_KEY=

# Optional: Supabase service role key (admin operations; keep secret).
# SUPABASE_SERVICE_ROLE_KEY=

# Optional: error/performance monitoring when running a study
# SENTRY_DSN=
